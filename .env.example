# Server
PORT=3000
NODE_ENV=development

# Timezone
TZ=Europe/Berlin

# Data
DATA_PATH=./src/data/guests.json

# Telegram Bot (optional)
# Get your token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Comma-separated list of authorized Telegram user/chat IDs (optional)
# Leave empty to allow all users (not recommended for public bots)
# To get your chat ID, message @userinfobot on Telegram
TELEGRAM_AUTHORIZED_USERS=
